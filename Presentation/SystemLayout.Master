<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="SystemLayout.master.cs"
    Inherits="FEHMS_FortEventHireManagementSystem.Presentation.SystemLayout" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title>Forte Events | Catering and Décor Hire</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Stylesheet/Forte.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <!-- MAIN NAVIGATION -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand" href="Home.aspx">
                <img src="../Images/FEHMS_Logo.jpeg"
                     alt="Forte Events Logo" />
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu"
                    aria-controls="navMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">

                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="Home.aspx">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="Catalogue.aspx">Catalogue</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="About.aspx">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="HowItWorks.aspx">How It Works</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="Reviews.aspx">Reviews</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="Contact.aspx">Contact Us</a>
                    </li>
                </ul>

                <div class="nav-icons">
                    <a href="Cart.aspx" class="cart-button" title="Shopping Cart">
                        <i class="bi bi-cart3"></i>
                    </a>

                    <asp:Button ID="btnLogin"
                        runat="server"
                        Text="Login"
                        CssClass="btn btn-login"
                        PostBackUrl="Login.aspx" />
                </div>

            </div>
        </div>
    </nav>

    <!-- MAIN PAGE AREA -->
    <main id="mainContentLayout" runat="server"
          class="main-content container">

        <!-- CUSTOMER SIDEBAR -->
        <asp:Panel ID="pnlCustomerSidebar" runat="server"
                   Visible="false" CssClass="customer-sidebar">

            <div class="customer-sidebar-inner">

                <div class="portal-brand">
                    <span class="portal-brand-icon">
                        <i class="bi bi-person-circle"></i>
                    </span>
                    <div>
                        <div class="portal-brand-title">Customer Portal</div>
                        <div class="portal-brand-sub">Manage your event hire</div>
                    </div>
                </div>

                <div class="portal-nav-label">Menu</div>

                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item">
                        <a href="CustomerDashboard.aspx" class="sidebar-nav-link">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="TrackOrder.aspx" class="sidebar-nav-link">
                            <i class="bi bi-calendar-event"></i>
                            <span>Track Order</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="Catalogue.aspx" class="sidebar-nav-link">
                            <i class="bi bi-bag-plus"></i>
                            <span>Continue Shopping</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="OrderSummary.aspx" class="sidebar-nav-link">
                            <i class="bi bi-receipt"></i>
                            <span>Order Summary</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="ManageProfile.aspx" class="sidebar-nav-link">
                            <i class="bi bi-person-gear"></i>
                            <span>Profile Settings</span>
                        </a>
                    </li>
                </ul>

                <div class="portal-sidebar-footer">
                    <asp:LinkButton ID="lnkCustomerLogout" runat="server"
                        CssClass="btn-sidebar-logout"
                        OnClick="lnkCustomerLogout_Click">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Log Out</span>
                    </asp:LinkButton>
                </div>

            </div>
        </asp:Panel>

        <!-- STAFF SIDEBAR -->
        <asp:Panel ID="pnlStaffSidebar" runat="server"
                   Visible="false" CssClass="staff-sidebar">

            <div class="staff-sidebar-inner">

                <div class="portal-brand">
                    <span class="portal-brand-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </span>
                    <div>
                        <div class="portal-brand-title">Staff Portal</div>
                        <div class="portal-brand-sub">Operations &amp; logistics</div>
                    </div>
                </div>

                <div class="portal-nav-label">Operations</div>

                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item">
                        <a href="StaffDashBoard.aspx" class="sidebar-nav-link">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="AssignedBookings.aspx" class="sidebar-nav-link">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Assigned Bookings</span>
                        </a>
                        </li>
                    <li class="sidebar-nav-item">
                        <a href="ManageDelivery.aspx" class="sidebar-nav-link">
                            <i class="bi bi-truck"></i>
                            <span>Manage Deliveries</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="ManageCollections.aspx" class="sidebar-nav-link">
                            <i class="bi bi-box-arrow-in-down"></i>
                            <span>Manage Collections</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="ManageReturns.aspx" class="sidebar-nav-link">
                            <i class="bi bi-arrow-repeat"></i>
                                <span>Manage Returns</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="StaffProfile.aspx" class="sidebar-nav-link">
                            <i class="bi bi-person-gear"></i>
                            <span>Profile Settings</span>
                        </a>
                    </li>
                </ul>

                <div class="portal-sidebar-footer">
                    <asp:LinkButton ID="lnkStaffLogout" runat="server"
                        CssClass="btn-sidebar-logout"
                        OnClick="lnkStaffLogout_Click">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Log Out</span>
                    </asp:LinkButton>
                </div>

            </div>
        </asp:Panel>

        <!-- CONTENT FOR ALL PAGES -->
        <div id="pageContent" runat="server" class="page-content">

            <asp:ContentPlaceHolder ID="MainContent" runat="server" />

        </div>

    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">

            <div class="row g-4">

                <div class="col-lg-3 col-md-6">
                    <img src="../Images/FEHMS_Logo.jpeg"
                         alt="Forte Events Logo"
                         class="footer-logo" />
                    <p class="footer-description">
                        Premium event hire equipment, catering solutions
                        and décor for memorable occasions.
                    </p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <a href="Home.aspx">Home</a>
                    <a href="Catalogue.aspx">Catalogue</a>
                    <a href="About.aspx">About Us</a>
                    <a href="HowItWorks.aspx">How It Works</a>
                    <a href="Contact.aspx">Contact Us</a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Our Services</h5>
                    <a href="Catalogue.aspx">Tents &amp; Marquees</a>
                    <a href="Catalogue.aspx">Tables &amp; Chairs</a>
                    <a href="Catalogue.aspx">Décor &amp; Lighting</a>
                    <a href="Catalogue.aspx">Sound &amp; Audio</a>
                    <a href="Catalogue.aspx">Catering Equipment</a>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Contact</h5>
                    <p class="footer-contact">
                        <i class="bi bi-telephone-fill"></i>
                        +27 73 244 0364
                    </p>
                    <p class="footer-contact">
                        <i class="bi bi-envelope-fill"></i>
                        info@codeandcofalcon.co.za
                    </p>
                    <p class="footer-contact">
                        <i class="bi bi-geo-alt-fill"></i>
                        East London, Eastern Cape
                    </p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Follow Us</h5>
                    <div class="social-icons">
                        <a href="#" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" title="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" title="WhatsApp">
                            <i class="bi bi-whatsapp"></i>
                        </a>
                    </div>
                </div>

            </div>

            <div class="footer-bottom">
                © <%: DateTime.Now.Year %>
                Forte Events Catering and Décor Hire |
                All Rights Reserved
            </div>

        </div>
    </footer>

    <!-- ACTIVE SIDEBAR LINK -->
    <script>
        (function () {
            var currentPage =
                window.location.pathname.split('/').pop().toLowerCase();

            var links = document.querySelectorAll(
                '.customer-sidebar .sidebar-nav-link, ' +
                '.staff-sidebar .sidebar-nav-link'
            );

            for (var i = 0; i < links.length; i++) {
                var target = links[i].getAttribute('href')
                    .split('?')[0].toLowerCase();

                if (target === currentPage) {
                    links[i].classList.add('active');
                }
            }
        })();
    </script>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>


