<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="SystemLayout.master.cs"
    Inherits="FEHMS_FortEventHireManagementSystem.Presentation.SystemLayout" %>

<!DOCTYPE html>
<html>
<head runat="server">

    <title>Forte Events | Catering and Décor Hire</title>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <style>

        /* =========================================================
           FORTE EVENTS - GLOBAL COLOUR PALETTE
           ========================================================= */

        :root {

            --forte-navy: #071827;
            --forte-dark: #0b1c2c;
            --forte-navy-light: #10263a;

            --forte-blue: #2457d6;
            --forte-blue-light: #3b6ff0;
            --forte-blue-dark: #173da3;

            --forte-white: #ffffff;
            --forte-silver: #d7dee8;
            --forte-grey: #94a3b8;

            --forte-border: rgba(255,255,255,0.10);

            --page-background: #f5f7fb;

            --shadow-soft: 0 8px 30px rgba(7,24,39,0.08);

            --shadow-blue: 0 8px 25px rgba(36,87,214,0.22);
        }


        /* =========================================================
           GLOBAL
           ========================================================= */

        html {
            scroll-behavior: smooth;
        }

        body {

            margin: 0;

            font-family: 'Inter', 'Segoe UI', sans-serif;

            background-color: var(--page-background);

            color: #172033;

            line-height: 1.6;
        }


        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .navbar-brand {

            font-family: 'Space Grotesk',
            'Segoe UI',
            sans-serif;

            font-weight: 600;

            letter-spacing: -0.3px;
        }


        a {
            transition: all 0.25s ease;
        }


        /* =========================================================
           NAVBAR
           ========================================================= */

        .navbar {

            background:
                linear-gradient(
                    135deg,
                    var(--forte-navy),
                    var(--forte-dark)
                );

            min-height: 86px;

            padding: 8px 0;

            border-bottom: 1px solid rgba(255,255,255,0.08);

            box-shadow:
                0 4px 20px rgba(0,0,0,0.12);

            position: relative;

            z-index: 1000;
        }


        /* Small blue line underneath navbar */

        .navbar::after {

            content: "";

            position: absolute;

            bottom: 0;

            left: 0;

            width: 100%;

            height: 2px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    var(--forte-blue),
                    transparent
                );

            opacity: 0.75;
        }


        /* =========================================================
           LOGO
           ========================================================= */

        .navbar-brand {

            display: flex;

            align-items: center;

            padding: 0;

            margin-right: 40px;
        }


        .navbar-brand img {

            height: 72px;

            width: auto;

            object-fit: contain;

            transition: transform 0.25s ease;
        }


        .navbar-brand:hover img {

            transform: scale(1.03);
        }


        /* =========================================================
           NAVIGATION LINKS
           ========================================================= */

        .navbar-nav {

            gap: 5px;
        }


        .nav-link {

            position: relative;

            font-family: 'Inter',
                'Segoe UI',
                sans-serif;

            font-size: 14px;

            font-weight: 500;

            color: #e8edf5 !important;

            padding: 10px 14px !important;

            border-radius: 8px;

            transition:
                color 0.25s ease,
                background 0.25s ease;
        }


        .nav-link:hover {

            color: var(--forte-white) !important;

            background-color:
                rgba(36,87,214,0.16);
        }


        /* Blue underline */

        .nav-link::after {

            content: "";

            position: absolute;

            bottom: 3px;

            left: 50%;

            width: 0;

            height: 2px;

            background-color:
                var(--forte-blue-light);

            border-radius: 5px;

            transform: translateX(-50%);

            transition: width 0.25s ease;
        }


        .nav-link:hover::after {

            width: 45%;
        }


        /* =========================================================
           RIGHT NAVIGATION AREA
           ========================================================= */

        .nav-icons {

            display: flex;

            align-items: center;

            gap: 10px;
        }


        /* =========================================================
           CART BUTTON
           ========================================================= */

        .cart-button {

            width: 42px;

            height: 42px;

            display: flex;

            align-items: center;

            justify-content: center;

            color: var(--forte-white);

            background:
                rgba(255,255,255,0.06);

            border: 1px solid
                rgba(255,255,255,0.12);

            border-radius: 9px;

            text-decoration: none;

            transition: all 0.25s ease;
        }


        .cart-button i {

            font-size: 18px;
        }


        .cart-button:hover {

            color: white;

            background:
                var(--forte-blue);

            border-color:
                var(--forte-blue);

            transform: translateY(-2px);

            box-shadow:
                var(--shadow-blue);
        }


        /* =========================================================
           LOGIN BUTTON
           ========================================================= */

        .btn-login {

            min-width: 92px;

            height: 42px;

            border-radius: 9px;

            border: 1px solid
                var(--forte-blue);

            background:
                var(--forte-blue);

            color: white !important;

            font-family: 'Inter',
                sans-serif;

            font-size: 14px;

            font-weight: 600;

            padding: 0 20px;

            transition: all 0.25s ease;
        }


        .btn-login:hover {

            background:
                var(--forte-blue-light);

            border-color:
                var(--forte-blue-light);

            color: white;

            transform: translateY(-2px);

            box-shadow:
                var(--shadow-blue);
        }


        /* =========================================================
           MOBILE NAVIGATION
           ========================================================= */

        .navbar-toggler {

            border: 1px solid
                rgba(255,255,255,0.20);

            border-radius: 8px;

            padding: 8px 10px;
        }


        .navbar-toggler:focus {

            box-shadow:
                0 0 0 3px
                rgba(36,87,214,0.25);
        }


        .navbar-toggler-icon {

            filter: invert(1);
        }


        /* =========================================================
           MAIN CONTENT
           ========================================================= */

        .main-content {

            padding-top: 35px;

            padding-bottom: 35px;

            min-height: 500px;
        }


        /* =========================================================
           GENERAL CARDS
           ========================================================= */

        .card {

            border: 1px solid #e7ebf1;

            border-radius: 14px;

            box-shadow: var(--shadow-soft);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }


        .card:hover {

            transform: translateY(-3px);

            box-shadow:
                0 12px 35px
                rgba(7,24,39,0.11);
        }


        /* =========================================================
           FORTE BUTTON
           ========================================================= */

        .btn-forte {

            background-color:
                var(--forte-blue);

            border: 1px solid
                var(--forte-blue);

            color: white;

            font-weight: 600;

            border-radius: 9px;

            padding: 10px 20px;

            transition: all 0.25s ease;
        }


        .btn-forte:hover {

            background-color:
                var(--forte-blue-light);

            border-color:
                var(--forte-blue-light);

            color: white;

            transform: translateY(-2px);

            box-shadow:
                var(--shadow-blue);
        }


        /* =========================================================
           OUTLINE FORTE BUTTON
           ========================================================= */

        .btn-forte-outline {

            background-color: transparent;

            border: 1px solid
                var(--forte-blue);

            color: var(--forte-blue);

            font-weight: 600;

            border-radius: 9px;

            padding: 10px 20px;

            transition: all 0.25s ease;
        }


        .btn-forte-outline:hover {

            background-color:
                var(--forte-blue);

            color: white;

            transform: translateY(-2px);
        }


        /* =========================================================
           TEXT UTILITIES
           ========================================================= */

        .text-forte {

            color:
                var(--forte-blue) !important;
        }


        .text-navy {

            color:
                var(--forte-navy) !important;
        }


        .bg-forte {

            background-color:
                var(--forte-blue) !important;
        }


        .bg-forte-navy {

            background-color:
                var(--forte-navy) !important;
        }


        /* =========================================================
           HERO SECTION
           ========================================================= */

        .hero-section {

            min-height: 450px;

            display: flex;

            align-items: center;

            position: relative;

            overflow: hidden;

            border-radius: 16px;

            background:

                linear-gradient(
                    rgba(7,24,39,0.78),
                    rgba(7,24,39,0.70)
                ),

                url('../Images/Hero background.jpg');

            background-size: cover;

            background-position: center;

            background-repeat: no-repeat;

            box-shadow:
                0 15px 45px
                rgba(7,24,39,0.16);
        }


        .hero-section::after {

            content: "";

            position: absolute;

            bottom: 0;

            left: 0;

            width: 100%;

            height: 4px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    var(--forte-blue),
                    transparent
                );
        }


        /* =========================================================
           FOOTER
           ========================================================= */

        .footer {

            background:
                linear-gradient(
                    135deg,
                    var(--forte-navy),
                    #091521
                );

            color: var(--forte-silver);

            padding:
                60px 0 20px;

            margin-top: 60px;

            position: relative;
        }


        /* Blue top border */

        .footer::before {

            content: "";

            position: absolute;

            top: 0;

            left: 0;

            width: 100%;

            height: 2px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    var(--forte-blue),
                    transparent
                );
        }


        /* =========================================================
           FOOTER LOGO
           ========================================================= */

        .footer-logo {

            height: 95px;

            width: auto;

            object-fit: contain;

            margin-bottom: 8px;
        }


        .footer-description {

            color:
                #aeb9c8;

            font-size: 14px;

            line-height: 1.7;

            max-width: 280px;
        }


        /* =========================================================
           FOOTER HEADINGS
           ========================================================= */

        .footer h5 {

            font-family:
                'Space Grotesk',
                sans-serif;

            color: white;

            font-size: 16px;

            font-weight: 600;

            margin-bottom: 20px;

            position: relative;
        }


        .footer h5::after {

            content: "";

            display: block;

            width: 30px;

            height: 2px;

            background:
                var(--forte-blue);

            margin-top: 8px;

            border-radius: 5px;
        }


        /* =========================================================
           FOOTER LINKS
           ========================================================= */

        .footer a {

            font-family:
                'Inter',
                sans-serif;

            color:
                #aeb9c8;

            text-decoration: none;

            display: block;

            margin-bottom: 9px;

            font-size: 14px;

            transition:
                color 0.25s ease,
                padding-left 0.25s ease;
        }


        .footer a:hover {

            color: white;

            padding-left: 4px;
        }


        /* =========================================================
           FOOTER CONTACT
           ========================================================= */

        .footer-contact {

            color:
                #aeb9c8;

            font-size: 14px;

            margin-bottom: 10px;
        }


        .footer-contact i {

            color:
                var(--forte-blue-light);

            margin-right: 8px;

            font-size: 15px;
        }


        /* =========================================================
           SOCIAL ICONS
           ========================================================= */

        .social-icons {

            display: flex;

            gap: 9px;
        }


        .social-icons a {

            width: 38px;

            height: 38px;

            display: flex;

            align-items: center;

            justify-content: center;

            color:
                #d7dee8;

            background:
                rgba(255,255,255,0.06);

            border:
                1px solid
                rgba(255,255,255,0.10);

            border-radius: 8px;

            margin: 0;

            padding: 0;

            transition: all 0.25s ease;
        }


        .social-icons a:hover {

            color: white;

            background:
                var(--forte-blue);

            border-color:
                var(--forte-blue);

            transform:
                translateY(-3px);

            padding-left: 0;
        }


        .social-icons i {

            font-size: 17px;
        }


        /* =========================================================
           FOOTER BOTTOM
           ========================================================= */

        .footer-bottom {

            border-top:
                1px solid
                rgba(255,255,255,0.08);

            margin-top: 40px;

            padding-top: 20px;

            text-align: center;

            color:
                #7f8da0;

            font-size: 13px;
        }


        /* =========================================================
           FORM CONTROLS
           ========================================================= */

        .form-control,
        .form-select {

            border-radius: 9px;

            border:
                1px solid #dce2ea;

            padding:
                10px 13px;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }


        .form-control:focus,
        .form-select:focus {

            border-color:
                var(--forte-blue);

            box-shadow:
                0 0 0 3px
                rgba(36,87,214,0.12);
        }


        /* =========================================================
           BADGES
           ========================================================= */

        .badge-forte {

            background:
                rgba(36,87,214,0.10);

            color:
                var(--forte-blue);

            border-radius: 6px;

            padding: 6px 10px;

            font-weight: 600;
        }


        /* =========================================================
           RESPONSIVE DESIGN
           ========================================================= */

        @media (max-width: 991px) {

            .navbar {

                padding:
                    10px 15px;
            }


            .navbar-brand {

                margin-right: 0;
            }


            .navbar-brand img {

                height: 65px;
            }


            .navbar-nav {

                margin-top: 15px;

                padding:
                    10px;

                background:
                    rgba(255,255,255,0.03);

                border-radius: 10px;
            }


            .nav-link {

                padding:
                    11px 13px !important;
            }


            .nav-icons {

                margin-top: 15px;

                padding-bottom: 8px;
            }
        }


        @media (max-width: 576px) {

            .main-content {

                padding:
                    20px 15px;
            }


            .hero-section {

                min-height: 380px;

                border-radius: 12px;
            }


            .footer {

                padding-top: 45px;
            }


            .footer .row > div {

                margin-bottom: 30px;
            }
        }

    </style>


    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form id="form1" runat="server">


    <!-- =========================================================
         NAVIGATION BAR
         ========================================================= -->

    <nav class="navbar navbar-expand-lg">

        <div class="container">


            <!-- LOGO -->

            <a class="navbar-brand"
               href="Dashboard.aspx">

                <img src="../Images/FEHMS_Logo.jpeg"
                     alt="Forte Events Logo" />

            </a>


            <!-- MOBILE TOGGLE -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu"
                    aria-controls="navMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- NAVIGATION MENU -->

            <div class="collapse navbar-collapse"
                 id="navMenu">


                <ul class="navbar-nav mx-auto">


                    <li class="nav-item">

                        <a class="nav-link"
                           href="Home.aspx">

                            Home

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="Catalogue.aspx">

                            Catalogue

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="About.aspx">

                            About Us

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="HowItWorks.aspx">

                            How It Works

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="Reviews.aspx">

                            Reviews

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="Contact.aspx">

                            Contact Us

                        </a>

                    </li>

                </ul>


                <!-- RIGHT SIDE -->

                <div class="nav-icons">


                    <!-- CART -->

                    <a href="Cart.aspx"
                       class="cart-button"
                       title="Shopping Cart">

                        <i class="bi bi-cart3"></i>

                    </a>


                    <!-- LOGIN -->

                    <asp:Button
                        ID="btnLogin"
                        runat="server"
                        Text="Login"
                        CssClass="btn btn-login" />

                </div>

            </div>

        </div>

    </nav>



    <!-- =========================================================
         MAIN PAGE CONTENT
         ========================================================= -->

    <main class="main-content container">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </main>



    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="footer">

        <div class="container">

            <div class="row g-4">


                <!-- BRAND -->

                <div class="col-lg-3 col-md-6">

                    <img src="../Images/FEHMS_Logo.jpeg"
                         alt="Forte Events Logo"
                         class="footer-logo" />

                    <p class="footer-description">

                        Premium event hire equipment,
                        catering solutions and décor
                        for memorable occasions.

                    </p>

                </div>


                <!-- QUICK LINKS -->

                <div class="col-lg-2 col-md-6">

                    <h5>Quick Links</h5>


                    <a href="Home.aspx">
                        Home
                    </a>


                    <a href="Catalogue.aspx">
                        Catalogue
                    </a>


                    <a href="About.aspx">
                        About Us
                    </a>


                    <a href="HowItWorks.aspx">
                        How It Works
                    </a>


                    <a href="Contact.aspx">
                        Contact Us
                    </a>

                </div>


                <!-- SERVICES -->

                <div class="col-lg-3 col-md-6">

                    <h5>Our Services</h5>


                    <a href="Catalogue.aspx">
                        Tents & Marquees
                    </a>


                    <a href="Catalogue.aspx">
                        Tables & Chairs
                    </a>


                    <a href="Catalogue.aspx">
                        Décor & Lighting
                    </a>


                    <a href="Catalogue.aspx">
                        Sound & Audio
                    </a>


                    <a href="Catalogue.aspx">
                        Catering Equipment
                    </a>

                </div>


                <!-- CONTACT -->

                <div class="col-lg-2 col-md-6">

                    <h5>Contact</h5>


                    <p class="footer-contact">

                        <i class="bi bi-telephone-fill"></i>

                        +27 73 244 0364

                    </p>


                    <p class="footer-contact">

                        <i class="bi bi-envelope-fill"></i>

                        info@codeandcofalcon.co.za

                    </p>


                    <p class="footer-contact">

                        <i class="bi bi-geo-alt-fill"></i>

                        East London,
                        Eastern Cape

                    </p>

                </div>


                <!-- SOCIAL MEDIA -->

                <div class="col-lg-2 col-md-6">

                    <h5>Follow Us</h5>


                    <div class="social-icons">


                        <a href="#"
                           title="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>


                        <a href="#"
                           title="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>


                        <a href="#"
                           title="WhatsApp">

                            <i class="bi bi-whatsapp"></i>

                        </a>


                    </div>

                </div>


            </div>


            <!-- FOOTER BOTTOM -->

            <div class="footer-bottom">

                © <%: DateTime.Now.Year %>
                Forte Events Catering and Décor Hire
                | All Rights Reserved

            </div>

        </div>

    </footer>


</form>


<!-- =========================================================
     BOOTSTRAP JAVASCRIPT
     ========================================================= -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
</script>


</body>
</html>