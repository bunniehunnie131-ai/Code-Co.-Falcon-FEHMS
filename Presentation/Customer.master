<%@ Master Language="C#" MasterPageFile="~/Presentation/SystemLayout.Master" AutoEventWireup="true" CodeBehind="Customer.master.cs" Inherits="FEHMS_FortEventHireManagementSystem.Presentation.Customer" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <link href="../Stylesheet/Forte.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="CustomerHead" runat="server">
    </asp:ContentPlaceHolder>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">

    <div class="portal-shell">

        <!-- SIDEBAR: flush left, header to footer, stays in view on scroll -->
        <aside class="portal-sidebar">
            <div class="portal-sidebar-inner">

                <div class="portal-brand">
                    <span class="portal-brand-icon"><i class="bi bi-person-circle"></i></span>
                    <span class="portal-brand-text">
                        <span class="portal-brand-title">Customer Portal</span>
                        <span class="portal-brand-sub">Manage your event hire</span>
                    </span>
                </div>

                <div class="portal-nav-label">Menu</div>

                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item">
                        <a href="CustomerDashboard.aspx" class="sidebar-nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="TrackOrder.aspx" class="sidebar-nav-link"><i class="bi bi-calendar-event"></i><span>Track Order</span></a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="Catalogue.aspx" class="sidebar-nav-link"><i class="bi bi-bag-plus"></i><span>Continue Shopping</span></a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="OrderSummary.aspx" class="sidebar-nav-link"><i class="bi bi-receipt"></i><span>Order Summary</span></a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a href="ManageProfile.aspx" class="sidebar-nav-link"><i class="bi bi-person-gear"></i><span>Profile Settings</span></a>
                    </li>
                </ul>

                <div class="portal-sidebar-footer">
                    <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CssClass="btn-sidebar-logout">
                        <i class="bi bi-box-arrow-right"></i><span>Log Out</span>
                    </asp:LinkButton>
                </div>

            </div>
        </aside>

        <!-- PAGE CONTENT -->
        <section class="portal-content">
            <asp:ContentPlaceHolder ID="CustomerContent" runat="server">
            </asp:ContentPlaceHolder>
        </section>

    </div>

    <script>
        // Highlight the sidebar link for the page that is currently open
        (function () {
            var here = window.location.pathname.split('/').pop().toLowerCase();
            var links = document.querySelectorAll('.sidebar-nav-link');
            for (var i = 0; i < links.length; i++) {
                var target = links[i].getAttribute('href').split('?')[0].toLowerCase();
                if (target === here) { links[i].classList.add('active'); }
            }
        })();
    </script>

</asp:Content>
